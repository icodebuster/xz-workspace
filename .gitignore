# The project repos: each is its own git repo, cloned here by setup.sh
/Axis-ERP/
/Axis-Docs/
/Axis-UI-Testing/
/Axis-UI-Reference/
/WhipIT/

# Scratch area, never committed
/_handoff/

# Local SonarQube for Axis-ERP: the setup is tracked, but never the token,
# the lock bin/sonar rebuilds on every run, or scan output
/Axis-Sonar/.env.sonar
/Axis-Sonar/Gemfile.lock
/Axis-Sonar/reports/

# Personal Claude Code settings for this machine
.claude/settings.local.json

# macOS
.DS_Store
