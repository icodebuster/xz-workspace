# Axis-ERP's own Gemfile plus SimpleCov, for coverage. bin/sonar points
# BUNDLE_GEMFILE here for every Ruby command it runs, so Axis-ERP's Gemfile and
# Gemfile.lock are never touched. Gemfile.lock beside this file is a copy of
# Axis-ERP's, refreshed by bin/sonar before each run (same gem versions as main).
axis_gemfile = File.expand_path("../Axis-ERP/Gemfile", __dir__)
eval_gemfile axis_gemfile

# Skipped if Simon ever adds SimpleCov himself (declaring a gem twice fails).
unless File.read(axis_gemfile).match?(/^\s*gem\s+["']simplecov["']/)
  group :test do
    gem "simplecov", "~> 1.3", require: false
  end
end
